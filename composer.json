{
  "minimum-stability": "dev",
  "prefer-stable": true,
  "require": {
    "php": "^8.4",
    "craftcms/ckeditor": "^5.9.0",
    "craftcms/cms": "^5.12.2",
    "nystudio107/craft-seomatic": "^5.1.24",
    "samuelreichor/craft-query-api": "*",
    "spacecatninja/imager-x": "^6.3.0",
    "verbb/cloner": "^3.0.6",
    "verbb/hyper": "^3.0.7",
    "verbb/navigation": "^4.1.0",
    "vlucas/phpdotenv": "^5.8.1"
  },
  "require-dev": {
    "craftcms/generator": "^2.2.0",
    "yiisoft/yii2-shell": "^2.0.6"
  },
  "config": {
    "allow-plugins": {
      "craftcms/plugin-installer": true,
      "yiisoft/yii2-composer": true
    },
    "sort-packages": true,
    "optimize-autoloader": true
  },
  "scripts": {
    "post-root-package-install": [
      "@php -r \"file_exists('.env') || copy('.env.example.dev', '.env');\""
    ]
  },
  "repositories": [
    {
      "type": "path",
      "url": "plugins/query-api"
    },
    {
      "type": "composer",
      "url": "https://composer.craftcms.com",
      "canonical": false
    }
  ],
  "autoload": {
    "psr-4": {
      "modules\\queryapiextension\\": "modules/query-api-extension/"
    }
  }
}
